rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user may only read and write their own profile document.
    // "write" also covers the create made at signup, and the document ID must
    // be the signed-in UID, so nobody can create a profile for someone else.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // A task belongs to the user its "owner" reference points to.
    match /tasks/{taskId} {
      allow read, update, delete: if request.auth != null
        && resource.data.owner == /databases/$(database)/documents/users/$(request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.owner == /databases/$(database)/documents/users/$(request.auth.uid);
    }
  }
}
